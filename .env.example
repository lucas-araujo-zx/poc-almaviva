# O mesmo token da bancada da Icatu. Fica só no servidor.
ALMAVIVA_LOGIN_TOKEN=

# Se ALMAVIVA_LOGIN_TOKEN estiver vazio, o servidor também aceita ICATU_LOGIN_TOKEN.
ICATU_LOGIN_TOKEN=

# Chave da conta ElevenLabs em que o agente da Almaviva existe.
ELEVENLABS_API_KEY=

# Opcional. Sem valor, a bancada usa o agente já publicado.
ALMAVIVA_VOICE_AGENT=
